# Copy this file to .env and fill in real values. Never commit the real .env file.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-random-secret-value

# True locally, False once deployed
DEBUG=True

# Comma-separated list of domains this site will be served from, e.g. mediscope.example.com,www.mediscope.example.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of frontend origins allowed to make cross-site requests, e.g. https://mediscope.example.com
CORS_ALLOWED_ORIGINS=

# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
